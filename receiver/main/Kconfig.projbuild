menu "CNC Wireless Transfer"

config CNC_DEFAULT_WIFI_SSID
    string "Default Wi-Fi SSID"
    default "CNC_WIRELESS"
    help
        Default SSID the receiver will connect to (should match the
        transmitter's AP SSID). Can be overridden via NVS at runtime.

config CNC_DEFAULT_WIFI_PASSWORD
    string "Default Wi-Fi Password"
    default "cnc12345"
    help
        Default password for the Wi-Fi network the receiver connects to.
        Must be at least 8 characters. Can be overridden via NVS at runtime.

config CNC_MDNS_HOSTNAME
    string "mDNS Hostname"
    default "cnc"
    help
        mDNS hostname prefix; the receiver ID is appended
        (e.g. cnc-rx-a1b2c3.local) so several receivers can coexist.

config CNC_MDNS_SERVICE
    string "mDNS Service Type"
    default "_cnc-wireless"
    help
        Service type advertised via mDNS. The transmitter will browse
        for this service to discover the receiver.

config CNC_USB_READ_LOG
    bool "Log USB host read activity"
    default y
    help
        While the USB host is reading, log once per second to the UART
        console: number of READ10 commands, bytes read and min/max LBA.

endmenu
