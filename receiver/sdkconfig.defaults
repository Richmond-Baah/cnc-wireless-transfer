# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash Size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CNC Wireless defaults (can be changed via menuconfig or Kconfig)
CONFIG_CNC_DEFAULT_WIFI_SSID="CNC_WIRELESS"
CONFIG_CNC_DEFAULT_WIFI_PASSWORD="cnc12345"

# TinyUSB
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DEBUG_LEVEL=1
CONFIG_TINYUSB_RHPORT_FS=y
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_TASK_PRIORITY=5
CONFIG_TINYUSB_TASK_STACK_SIZE=4096
CONFIG_TINYUSB_TASK_AFFINITY_NO_AFFINITY=y
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=y
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Espressif Systems"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="USB Flash Drive"
CONFIG_TINYUSB_DESC_SERIAL_STRING="1234567890"
CONFIG_TINYUSB_DESC_MSC_STRING="MSC Device"
CONFIG_TINYUSB_MSC_BUFSIZE=512
CONFIG_TINYUSB_FAT_FORMAT_ANY=y

# FATFS - CRITICAL: 512-byte sectors for printer compatibility
CONFIG_FATFS_LONG_FILENAMES=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_FATFS_PER_FILE_CACHE=y

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# mbedTLS MD5
CONFIG_MBEDTLS_MD5_C=y

# USB Console - Disable USB Serial/JTAG, use UART
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_CDC=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# USB Serial/JTAG - Explicitly disable to prevent PHY contention with TinyUSB
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3

# CPU Frequency - 240MHz for stable WiFi operation
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Power Management - DISABLED for WiFi STA reliability
# CONFIG_PM_ENABLE is not set

# mDNS - advertise as cnc-receiver.local / _cnc-wireless._tcp:80
CONFIG_MDNS_ENABLED=y
CONFIG_MDNS_MAX_SERVICES=4
CONFIG_MDNS_SERVICE_ADD_TIMEOUT_MS=2000
CONFIG_MDNS_TIMER_PERIOD_MS=100
CONFIG_MDNS_NETWORKING_SOCKET=y

# Wi-Fi TX power in 0.25 dBm units (34 = 8.5 dBm)
CONFIG_CNC_WIFI_MAX_TX_POWER=34

# Throughput (docs/TRANSFER_PERF.md): TCP window/send buffer 32 KB (was 5760 =
# 4 MSS, the main per-leg limit), larger Wi-Fi RX buffers and block-ack windows.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
# Core dump to the 64 KB coredump partition (ELF), downloadable from Settings > System
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# OTA: new image is confirmed by an accepted heartbeat or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Signed apps without hardware secure boot (no eFuses burned): every OTA image
# must carry an RSA-3072 signature from the same key as the running app.
# Signing is done in CMakeLists.txt from $FILEXFER_SIGNING_KEY.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

# System event task: rx sys_evt had 440 B free at 2304 (stack audit)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
