# Target
CONFIG_IDF_TARGET="esp32s3"

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SPIFFS
CONFIG_SPIFFS_MAX_PARTITIONS=3

# CNC Wireless defaults (can be changed via menuconfig or Kconfig)
CONFIG_CNC_DEFAULT_WIFI_SSID="CNC_WIRELESS"
CONFIG_CNC_DEFAULT_WIFI_PASSWORD="cnc12345"
CONFIG_CNC_DEFAULT_WEB_USER="admin"
CONFIG_CNC_DEFAULT_WEB_PASS="admin123"

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Sockets: httpd (13 + 3 reserved) + 2 worker clients to receivers, with headroom
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24

# ESP HTTP Client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# mbedTLS MD5
CONFIG_MBEDTLS_MD5_C=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3

# Wi-Fi TX power in 0.25 dBm units (34 = 8.5 dBm)
CONFIG_CNC_WIFI_MAX_TX_POWER=34
