# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash Size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CNC Wireless defaults (can be changed via menuconfig or Kconfig)
CONFIG_CNC_DEFAULT_WIFI_SSID="CNC_WIRELESS"
CONFIG_CNC_DEFAULT_WIFI_PASSWORD="cnc12345"
CONFIG_CNC_DEFAULT_WEB_USER="admin"
CONFIG_CNC_DEFAULT_WEB_PASS="admin123"

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Sockets: httpd (13 + 3 reserved) + 2 worker clients to receivers, with headroom
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24

# ESP HTTP Client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# mbedTLS MD5
CONFIG_MBEDTLS_MD5_C=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=3

# Wi-Fi TX power in 0.25 dBm units (34 = 8.5 dBm)
CONFIG_CNC_WIFI_MAX_TX_POWER=34

# Throughput (docs/TRANSFER_PERF.md): TCP window/send buffer 32 KB (was 5760 =
# 4 MSS, the main per-leg limit), larger Wi-Fi RX buffers and block-ack windows.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Core dump to the 64 KB coredump partition (ELF), downloadable from Settings > System
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# OTA: new image must confirm itself (fw_update_confirm_boot) or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Signed apps without hardware secure boot (no eFuses burned): every OTA image
# must carry an RSA-3072 signature from the same key as the running app.
# Signing is done in CMakeLists.txt from $FILEXFER_SIGNING_KEY.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

# System event task: rx sys_evt had 440 B free at 2304 (stack audit)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# IPC tasks: ipc0 had 496 B free at 1280 under load (stack audit)
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
